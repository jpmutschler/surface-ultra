// Bake-off tasks. One JSON object per line. Add your own: real tool schemas from serialcables-mcp,
// questions from NDA vendor docs (keep those in a local-only file), and regressions you hit.
{"id": "tool-link-status", "type": "toolcall", "prompt": "What's the negotiated link speed and width on switch port 12 right now?", "expect": {"name": "get_link_status", "args": {"port": 12}}}
{"id": "tool-config-read", "type": "toolcall", "prompt": "Read 64 bytes of config space starting at offset 0x100 for device 0000:3b:00.0.", "expect": {"name": "read_config_space", "args": {"bdf": "0000:3b:00.0", "offset": 256, "length": 64}}}
{"id": "tool-port-power-off", "type": "toolcall", "prompt": "Turn off slot power on downstream port 5.", "expect": {"name": "set_port_power", "args": {"port": 5, "enabled": false}}}
{"id": "tool-nvme-mi-poll", "type": "toolcall", "prompt": "Poll the subsystem health of the SSD in JBOF slot 2 over NVMe-MI.", "expect": {"name": "nvme_mi_health_poll", "args": {"slot": 2}}}
{"id": "tool-i3c-daa", "type": "toolcall", "prompt": "Assign dynamic addresses to every target on I3C bus 1.", "expect": {"name": "i3c_entdaa", "args": {"bus": 1}}}
{"id": "tool-none-explain", "type": "toolcall", "prompt": "Explain conceptually what ENTDAA does in I3C. Don't touch any hardware.", "expect": null}
{"id": "tool-none-theory", "type": "toolcall", "prompt": "Why does PCIe 6.0 need FEC when Gen5 did not? Short answer, no hardware access.", "expect": null}
{"id": "qa-flit-size", "type": "qa", "prompt": "In PCIe 6.0 FLIT mode, how many bytes is one FLIT?", "expect_any": ["256"]}
{"id": "qa-gen6-modulation", "type": "qa", "prompt": "What signaling/modulation does PCIe 6.0 use at 64 GT/s?", "expect_any": ["pam4", "pam-4", "pam 4"]}
{"id": "qa-gen7-rate", "type": "qa", "prompt": "What is the per-lane raw data rate of PCIe 7.0?", "expect_any": ["128 gt/s", "128gt/s", "128 gt"]}
{"id": "qa-ltssm-after-detect", "type": "qa", "prompt": "During normal link training, which LTSSM state follows Detect?", "expect_any": ["polling"]}
{"id": "qa-gen6-fec", "type": "qa", "prompt": "Besides CRC, what does PCIe 6.0 FLIT mode use to correct bit errors? Name the mechanism.", "expect_any": ["fec", "forward error correction"]}
{"id": "qa-nvme-mi-transport", "type": "qa", "prompt": "Over SMBus/I2C, NVMe-MI messages are carried by which transport protocol?", "expect_any": ["mctp"]}
{"id": "qa-cxl-protocols", "type": "qa", "prompt": "Name the three protocols CXL multiplexes on one link.", "expect_all": ["cxl.io", "cxl.cache", "cxl.mem"]}
{"id": "qa-cxl-type2", "type": "qa", "prompt": "Which CXL device type is an accelerator with its own host-managed memory that uses CXL.io, CXL.cache and CXL.mem?", "expect_any": ["type 2", "type-2", "type2"]}
{"id": "qa-i3c-daa-ccc", "type": "qa", "prompt": "In MIPI I3C, which broadcast CCC starts Dynamic Address Assignment?", "expect_any": ["entdaa"]}
{"id": "code-crc8-smbus", "type": "code", "prompt": "Write a Python function crc8_smbus(data: bytes) -> int that computes the SMBus PEC (CRC-8, polynomial 0x07, init 0x00, no reflection, no final XOR). Return only one python code block.", "test": "assert crc8_smbus(b'123456789') == 0xF4\nassert crc8_smbus(b'') == 0"}
{"id": "code-crc32c", "type": "code", "prompt": "Write a Python function crc32c(data: bytes) -> int implementing CRC-32C (Castagnoli, reflected polynomial 0x82F63B78, init 0xFFFFFFFF, final XOR 0xFFFFFFFF) as used for the NVMe-MI message integrity check. No third-party packages. Return only one python code block.", "test": "assert crc32c(b'123456789') == 0xE3069283\nassert crc32c(b'') == 0"}
{"id": "code-link-status", "type": "code", "prompt": "Write a Python function parse_link_status(reg: int) -> dict that decodes a 16-bit PCIe Link Status register into {'speed': <Current Link Speed field, bits 3:0>, 'width': <Negotiated Link Width field, bits 9:4>}. Return only one python code block.", "test": "assert parse_link_status(0x1043) == {'speed': 3, 'width': 4}\nassert parse_link_status(0x0086)['speed'] == 6 and parse_link_status(0x0086)['width'] == 8"}
{"id": "code-mctp-header", "type": "code", "prompt": "Write a Python function mctp_header(dest_eid: int, src_eid: int, som: bool, eom: bool, pkt_seq: int, tag_owner: bool, msg_tag: int) -> bytes that builds the 4-byte MCTP transport header (DSP0236): byte0 = header version 1 in the low nibble, byte1 = destination EID, byte2 = source EID, byte3 = SOM bit7, EOM bit6, packet sequence bits5:4, TO bit3, message tag bits2:0. Return only one python code block.", "test": "assert mctp_header(0x1D, 0x08, True, True, 0, True, 3) == bytes([0x01, 0x1D, 0x08, 0xCB])\nassert mctp_header(9, 8, False, True, 2, False, 1) == bytes([0x01, 0x09, 0x08, 0x61])"}
// Grounded research tasks over a FICTIONAL vendor excerpt (ORCA-7) - tests faithfulness, citation and abstention.
{"id": "grd-eq-offset", "type": "grounded", "context": "[p.41] 7.3 ORCA-7 Retimer Control. The LANE_EQ_CTRL register (offset 0x3A0) selects the receiver equalization preset. Bits 3:0 hold the preset index (P0-P10); bit 7 (EQ_LOCK) freezes the preset after link training. Writes take effect at the next entry to Recovery.Equalization. [p.42] 7.4 Thermal. The retimer asserts THERM_ALERT# when the die exceeds 105 C. Firmware polls TEMP_STATUS (offset 0x3C4) every 10 ms; bits 15:8 report the die temperature in degrees C. Writing 1 to bit 0 of TEMP_STATUS clears a latched alert.", "prompt": "What is the offset of the register that selects the receiver equalization preset?", "expect_any": ["0x3a0"], "expect_cite": "p.41"}
{"id": "grd-eq-lock", "type": "grounded", "context": "[p.41] 7.3 ORCA-7 Retimer Control. The LANE_EQ_CTRL register (offset 0x3A0) selects the receiver equalization preset. Bits 3:0 hold the preset index (P0-P10); bit 7 (EQ_LOCK) freezes the preset after link training. Writes take effect at the next entry to Recovery.Equalization. [p.42] 7.4 Thermal. The retimer asserts THERM_ALERT# when the die exceeds 105 C. Firmware polls TEMP_STATUS (offset 0x3C4) every 10 ms; bits 15:8 report the die temperature in degrees C. Writing 1 to bit 0 of TEMP_STATUS clears a latched alert.", "prompt": "Which bit freezes the EQ preset after link training, and what is it called?", "expect_all": ["7", "eq_lock"], "expect_cite": "p.41"}
{"id": "grd-eq-timing", "type": "grounded", "context": "[p.41] 7.3 ORCA-7 Retimer Control. The LANE_EQ_CTRL register (offset 0x3A0) selects the receiver equalization preset. Bits 3:0 hold the preset index (P0-P10); bit 7 (EQ_LOCK) freezes the preset after link training. Writes take effect at the next entry to Recovery.Equalization. [p.42] 7.4 Thermal. The retimer asserts THERM_ALERT# when the die exceeds 105 C. Firmware polls TEMP_STATUS (offset 0x3C4) every 10 ms; bits 15:8 report the die temperature in degrees C. Writing 1 to bit 0 of TEMP_STATUS clears a latched alert.", "prompt": "When does a write to LANE_EQ_CTRL take effect?", "expect_any": ["recovery.equalization", "recovery equalization"]}
{"id": "grd-therm-threshold", "type": "grounded", "context": "[p.41] 7.3 ORCA-7 Retimer Control. The LANE_EQ_CTRL register (offset 0x3A0) selects the receiver equalization preset. Bits 3:0 hold the preset index (P0-P10); bit 7 (EQ_LOCK) freezes the preset after link training. Writes take effect at the next entry to Recovery.Equalization. [p.42] 7.4 Thermal. The retimer asserts THERM_ALERT# when the die exceeds 105 C. Firmware polls TEMP_STATUS (offset 0x3C4) every 10 ms; bits 15:8 report the die temperature in degrees C. Writing 1 to bit 0 of TEMP_STATUS clears a latched alert.", "prompt": "At what die temperature is THERM_ALERT# asserted?", "expect_any": ["105"], "expect_cite": "p.42"}
{"id": "grd-temp-field", "type": "grounded", "context": "[p.41] 7.3 ORCA-7 Retimer Control. The LANE_EQ_CTRL register (offset 0x3A0) selects the receiver equalization preset. Bits 3:0 hold the preset index (P0-P10); bit 7 (EQ_LOCK) freezes the preset after link training. Writes take effect at the next entry to Recovery.Equalization. [p.42] 7.4 Thermal. The retimer asserts THERM_ALERT# when the die exceeds 105 C. Firmware polls TEMP_STATUS (offset 0x3C4) every 10 ms; bits 15:8 report the die temperature in degrees C. Writing 1 to bit 0 of TEMP_STATUS clears a latched alert.", "prompt": "Which bits of TEMP_STATUS report the die temperature?", "expect_any": ["15:8", "15-8", "15 to 8", "bits 8"]}
{"id": "abs-eq-reset", "type": "abstain", "context": "[p.41] 7.3 ORCA-7 Retimer Control. The LANE_EQ_CTRL register (offset 0x3A0) selects the receiver equalization preset. Bits 3:0 hold the preset index (P0-P10); bit 7 (EQ_LOCK) freezes the preset after link training. Writes take effect at the next entry to Recovery.Equalization. [p.42] 7.4 Thermal. The retimer asserts THERM_ALERT# when the die exceeds 105 C. Firmware polls TEMP_STATUS (offset 0x3C4) every 10 ms; bits 15:8 report the die temperature in degrees C. Writing 1 to bit 0 of TEMP_STATUS clears a latched alert.", "prompt": "What is the reset value of LANE_EQ_CTRL?", "forbid": ["0x00 after reset", "reset value is 0"]}
{"id": "abs-lanes", "type": "abstain", "context": "[p.41] 7.3 ORCA-7 Retimer Control. The LANE_EQ_CTRL register (offset 0x3A0) selects the receiver equalization preset. Bits 3:0 hold the preset index (P0-P10); bit 7 (EQ_LOCK) freezes the preset after link training. Writes take effect at the next entry to Recovery.Equalization. [p.42] 7.4 Thermal. The retimer asserts THERM_ALERT# when the die exceeds 105 C. Firmware polls TEMP_STATUS (offset 0x3C4) every 10 ms; bits 15:8 report the die temperature in degrees C. Writing 1 to bit 0 of TEMP_STATUS clears a latched alert.", "prompt": "How many lanes does the ORCA-7 retimer support?", "forbid": ["16 lanes", "8 lanes", "x16", "x8"]}
{"id": "abs-gen", "type": "abstain", "context": "[p.41] 7.3 ORCA-7 Retimer Control. The LANE_EQ_CTRL register (offset 0x3A0) selects the receiver equalization preset. Bits 3:0 hold the preset index (P0-P10); bit 7 (EQ_LOCK) freezes the preset after link training. Writes take effect at the next entry to Recovery.Equalization. [p.42] 7.4 Thermal. The retimer asserts THERM_ALERT# when the die exceeds 105 C. Firmware polls TEMP_STATUS (offset 0x3C4) every 10 ms; bits 15:8 report the die temperature in degrees C. Writing 1 to bit 0 of TEMP_STATUS clears a latched alert.", "prompt": "Does the ORCA-7 support PCIe 7.0 at 128 GT/s?", "forbid": ["yes, it supports", "supports pcie 7.0"]}
