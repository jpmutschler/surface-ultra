# GENERATED by scripts/40-Wsl.ps1 from config/wslconfig.template
# Docs: https://learn.microsoft.com/windows/wsl/wsl-config
[wsl2]
# Unified memory is shared with the GPU. Keep the VM small so native llama.cpp keeps its budget.
memory={{WSL_MEMORY_GB}}GB
swap={{WSL_SWAP_GB}}GB
processors={{WSL_PROCESSORS}}
# Mirrored networking: WSL and Windows share localhost, so containers on the host network
# reach llama-swap at 127.0.0.1:8080 and Windows reaches LiteLLM at 127.0.0.1:4000.
networkingMode=mirrored
dnsTunneling=true
autoProxy=true
firewall=true
defaultVhdSize={{WSL_VHD_MAX_GB}}GB

[experimental]
autoMemoryReclaim=gradual
sparseVhd=true
